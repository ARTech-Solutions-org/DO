# Server-only. The mock provider works offline. OpenAI edits use a billable API.
IMAGE_EDIT_PROVIDER=mock
IMAGE_EDIT_MODEL=gpt-image-2.5-flare
IMAGE_EDIT_API_KEY=

# local uses the mock. local-live uses OpenAI on loopback. hosted requires deployment settings.
BOOTH_MODE=
BOOTH_DATA_DIR=
BOOTH_PUBLIC_ORIGIN=
BOOTH_KIOSK_SECRET=
BOOTH_TOKEN_SECRET=
BOOTH_RETENTION_SECONDS=86400
BOOTH_JOB_TIMEOUT_SECONDS=200
BOOTH_QR_IDLE_SECONDS=60
BOOTH_THANK_YOU_SECONDS=6
BOOTH_EXPORT_FORMAT=png
BOOTH_MOCK_DELAY_SECONDS=2
RATE_LIMIT_PER_MINUTE=6
RATE_LIMIT_PER_HOUR=60
